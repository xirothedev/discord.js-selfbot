{
  "name": "@discord-ts-selfbot/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for discord-ts-selfbot",
  "type": "module",
  "scripts": {
    "dev": "bun run api && next dev",
    "build": "bun run api && next build",
    "docs": "next build",
    "start": "serve out",
    "api": "bun run scripts/generate-api.ts",
    "api:check": "bun run scripts/generate-api.ts --check",
    "check": "bun run api && fumadocs-mdx && next typegen && tsc --noEmit",
    "lint": "bun lint",
    "fmt": "bun fmt app components lib scripts next.config.mjs postcss.config.mjs package.json tsconfig.json",
    "fmt:check": "bun fmt --check app components lib scripts next.config.mjs postcss.config.mjs package.json tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "fumadocs-core": "16.18.2",
    "fumadocs-mdx": "15.5.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@discordjs/docgen": "^0.11.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  }
}
