{
  "name": "discord-selfbot-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @discord-selfbot/core and related packages",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "bun lint --no-script --max-warnings=0",
    "lint:packages": "turbo run lint",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "fmt:packages": "turbo run fmt",
    "fmt:check:packages": "turbo run fmt:check",
    "test": "turbo run test",
    "docs": "turbo run docs",
    "schema:generate": "bun run --cwd packages/discord-ts-selfbot schema:generate",
    "schema:check": "bun run --cwd packages/discord-ts-selfbot schema:check",
    "ratchet:check": "bun run --cwd packages/discord-ts-selfbot ratchet:check",
    "ratchet:write": "bun run --cwd packages/discord-ts-selfbot ratchet:write",
    "lint:boundaries": "bun run --cwd packages/discord-ts-selfbot lint:boundaries",
    "bench": "bun run --cwd tools/bench start",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:api": "bun run --cwd apps/docs api",
    "docs:agent": "bun run --cwd packages/discord-ts-selfbot docs:generate",
    "docs:agent:check": "bun run --cwd packages/discord-ts-selfbot docs:check",
    "docs:snippets": "bun run --cwd apps/docs snippets",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "lint-staged": "^15.2.0",
    "oxlint": "1.90.0",
    "turbo": "^2.11.10",
    "ultracite": "8.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "bun lint --no-script --fix"
  },
  "packageManager": "bun@1.4.4"
}
