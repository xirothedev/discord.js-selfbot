{
  "name": "@discord-ts-selfbot/test-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Private fake Discord HTTP + WebSocket server for TDD seams",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --dts --outdir=dist",
    "check": "bun check",
    "lint": "bun lint",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "test": "bun test --pass-with-no-tests"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.4"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
