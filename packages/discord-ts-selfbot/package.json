{
  "name": "discord-ts-selfbot",
  "version": "14.0.1",
  "description": "An unofficial discord.js fork for creating selfbots, migrated to TypeScript and ESM",
  "keywords": [
    "api",
    "bot",
    "client",
    "discord",
    "discord.js",
    "discordapp",
    "djs",
    "node",
    "selfbot",
    "selfbot v14"
  ],
  "homepage": "https://xirothedev.github.io/discord.js-selfbot/",
  "bugs": {
    "url": "https://github.com/xirothedev/discord.js-selfbot/issues"
  },
  "license": "GNU General Public License v3.0",
  "author": "xirothedev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xirothedev/discord.js-selfbot.git"
  },
  "directories": {
    "lib": "src",
    "test": "tests"
  },
  "files": [
    "src",
    "typings",
    "dist",
    "docs",
    "README.md"
  ],
  "main": "./src/index.ts",
  "types": "./typings/index.d.ts",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --format=esm --outdir=dist --packages=external",
    "check": "bun check && bun run schema:check && bun run ratchet:check && bun run docs:check",
    "lint": "bun lint",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "test": "bun test",
    "test:types": "bun x tsc --noEmit -p tsconfig.test.json",
    "test:typescript": "bun check",
    "schema:generate": "bun tools/schema/generate.ts",
    "schema:check": "bun tools/schema/generate.ts --check",
    "ratchet:check": "bun ../../tools/typesafety/count.ts --check",
    "ratchet:write": "bun ../../tools/typesafety/count.ts --write",
    "docs:generate": "bun run ../../apps/docs/scripts/agent/generate.ts",
    "docs:check": "bun run ../../apps/docs/scripts/agent/generate.ts --check",
    "lint:boundaries": "depcruise src/packages",
    "all": "bun run build && bun publish",
    "test:manual": "bun test tests/manual"
  },
  "dependencies": {
    "@discordjs/builders": "^1.6.3",
    "@discordjs/collection": "^2.1.1",
    "@sapphire/async-queue": "^1.5.5",
    "@sapphire/shapeshift": "^4.0.0",
    "discord-api-types": "^0.38.15",
    "fetch-cookie": "^3.1.0",
    "find-process": "^2.0.0",
    "otplib": "^12.0.1",
    "prism-media": "^1.3.5",
    "qrcode": "^1.5.4",
    "tough-cookie": "^5.1.2",
    "tree-kill": "^1.2.2",
    "undici": "^7.11.0",
    "werift-rtp": "^0.8.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@discord-ts-selfbot/test-harness": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.10",
    "dependency-cruiser": "^18.7.2",
    "dtslint": "^4.2.1",
    "tsd": "^0.32.0",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.4"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
