{
  "name": "discord-ts-selfbot",
  "version": "14.0.0",
  "description": "An unofficial discord.js fork for creating selfbots, migrated to TypeScript and ESM",
  "main": "./src/index.js",
  "types": "./typings/index.d.ts",
  "scripts": {
    "build": "bun build src/index.js --target=bun --format=esm --outdir=dist --packages=external",
    "check": "bun check",
    "lint": "bun lint",
    "fmt": "bun fmt src typings",
    "fmt:check": "bun fmt --check src typings",
    "test": "bun test",
    "test:types": "bun check",
    "test:typescript": "bun check",
    "lint:boundaries": "depcruise src/packages",
    "all": "bun run build && bun publish",
    "docs": "docgen --source src --custom ../../docs/index.yml --output ../../docs/main.json",
    "docs:test": "docgen --source src --custom ../../docs/index.yml",
    "docs:typedoc": "typedoc --options typedoc.json"
  },
  "files": [
    "src",
    "typings",
    "dist"
  ],
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xirothedev/discord.js-selfbot.git"
  },
  "keywords": [
    "discord.js",
    "selfbot",
    "selfbot v14",
    "djs",
    "api",
    "bot",
    "node",
    "discord",
    "client",
    "discordapp"
  ],
  "author": "xirothedev",
  "license": "GNU General Public License v3.0",
  "dependencies": {
    "@discordjs/builders": "^1.6.3",
    "@discordjs/collection": "^2.1.1",
    "@sapphire/async-queue": "^1.5.5",
    "@sapphire/shapeshift": "^4.0.0",
    "discord-api-types": "^0.38.15",
    "fetch-cookie": "^3.1.0",
    "find-process": "^2.0.0",
    "otplib": "^12.0.1",
    "prism-media": "^1.3.5",
    "qrcode": "^1.5.4",
    "tough-cookie": "^5.1.2",
    "tree-kill": "^1.2.2",
    "undici": "^7.11.0",
    "werift-rtp": "^0.8.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@discord-ts-selfbot/test-harness": "workspace:*",
    "@discordjs/docgen": "^0.11.1",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.10",
    "dependency-cruiser": "^18.7.2",
    "dtslint": "^4.2.1",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.8",
    "tsd": "^0.32.0",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.4"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
